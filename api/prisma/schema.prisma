// FieldOps Cloud — PostgreSQL schema (Prisma ORM 7)
// Tenant-owned records carry organizationId. Org roles live on OrganizationMember, never on User.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATIONS_MANAGER
  SUPERVISOR
  TECHNICIAN
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  NONE
  TRIALING
  GRACE
  ACTIVE
  PAST_DUE
  TRIAL_EXPIRED
  PAID_GRACE
  EXPIRED
  SUSPENDED
  CANCELED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  CUSTOM
}

enum CommercialRequestType {
  ACTIVATION
  RENEWAL
  PLAN_CHANGE
}

enum ActivationRequestStatus {
  OPEN
  CONTACTED
  COMPLETED
  CLOSED
}

enum InvoiceType {
  ACTIVATION
  RENEWAL
  PLAN_CHANGE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum JobStatus {
  DRAFT
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  RETURNED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobAssignmentRole {
  LEAD
  TECHNICIAN
}

enum JobFileType {
  PHOTO
  DOCUMENT
  SIGNATURE
  OTHER
}

enum StorageUploadStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum StorageUploadPurpose {
  JOB_FILE
  ORGANIZATION_LOGO
}

enum JobOutcome {
  COMPLETED
  PARTIALLY_COMPLETED
  FOLLOW_UP_REQUIRED
  UNABLE_TO_COMPLETE
}

enum ClockSessionStatus {
  OPEN
  CLOSED
  VOIDED
}

enum TimeEntrySource {
  CLOCK_SESSION
  MANUAL
}

enum TimeEntryType {
  NORMAL
  OVERTIME
  TRAVEL
  STANDBY
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

enum ApprovalType {
  TIMESHEET
  OVERTIME
  JOB_COMPLETION
  TIME_ADJUSTMENT
  SAFETY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
  CANCELLED
}

enum OvertimeAuthorizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationStatus {
  UNREAD
  READ
}

// ---------------------------------------------------------------------------
// Platform identity
// ---------------------------------------------------------------------------

model User {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique
  emailVerifiedAt  DateTime?    @db.Timestamptz
  /// When set, this verified account has permanently consumed its one lifetime Professional free trial.
  /// Never clear under normal product operations (including org deletion).
  trialUsedAt      DateTime?    @db.Timestamptz
  passwordHash     String
  fullName         String
  phone            String?
  avatarUrl        String?
  platformRole     PlatformRole @default(USER)
  status           UserStatus   @default(ACTIVE)
  termsAcceptedAt  DateTime?    @db.Timestamptz
  termsVersion     String?
  privacyVersion   String?
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  refreshSessions         RefreshSession[]
  memberships             OrganizationMember[]
  invitationsSent         OrganizationInvitation[] @relation("InvitationInviter")
  teamMemberships         TeamMember[]
  supervisedTeams         Team[]                   @relation("TeamSupervisor")
  technicianSkills        TechnicianSkill[]
  certifications          TechnicianCertification[]
  supervisedJobs          Job[]                    @relation("JobSupervisor")
  jobAssignments          JobAssignment[]
  authoredWorkLogs        JobWorkLog[]
  addedMaterials          JobMaterial[]
  uploadedJobFiles        JobFile[]
  storageUploads          StorageUpload[]
  completedSafetyControls JobSafetyControl[]
  capturedSignatures      JobSignature[]
  clockSessions           ClockSession[]
  timeEntries             TimeEntry[]
  overtimeSubjects        OvertimeAuthorization[]  @relation("OvertimeSubject")
  overtimeRequests        OvertimeAuthorization[]  @relation("OvertimeRequester")
  overtimeDecisions       OvertimeAuthorization[]  @relation("OvertimeDecider")
  approvalsRequested      Approval[]               @relation("ApprovalRequester")
  approvalsDecided        Approval[]               @relation("ApprovalDecider")
  approvalsAssigned       Approval[]               @relation("ApprovalAssignee")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  activatedSubscriptions    Subscription[]           @relation("SubscriptionActivator")
  activationRequests        ActivationRequest[]
  invoicesCreated           Invoice[]                @relation("InvoiceCreator")
  paymentNotices            InvoicePaymentNotice[]

  @@index([status])
  @@index([platformRole])
}

/// Hashed, single-use email verification secrets. Raw tokens are never stored.
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt])
}

/// Hashed, single-use password reset secrets. Raw tokens are never stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  userAgent  String?
  ipAddress  String?
  deviceName String?
  createdAt  DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String             @unique
  logoUrl                String?
  /// Private object storage key for the organization logo. Prefer this over logoUrl.
  logoObjectKey          String?
  /// Metered size of the current logo object (bytes). Null when no logo is stored.
  logoSizeBytes          BigInt?
  email                  String
  phone                  String?
  industry               String?
  timezone               String
  onboardingStep         Int                @default(1)
  onboardingCompletedAt  DateTime?          @db.Timestamptz
  status                 OrganizationStatus @default(ACTIVE)
  createdAt              DateTime           @default(now()) @db.Timestamptz
  updatedAt              DateTime           @updatedAt @db.Timestamptz

  members                OrganizationMember[]
  invitations            OrganizationInvitation[]
  settings               OrganizationSettings?
  subscription           Subscription?
  activationRequests        ActivationRequest[]
  subscriptionNotifications SubscriptionNotification[]
  invoices                  Invoice[]
  paymentNotices            InvoicePaymentNotice[]
  jobCounter             OrganizationCounter?
  teams                  Team[]
  teamMembers            TeamMember[]
  skills                 Skill[]
  technicianSkills       TechnicianSkill[]
  certifications         TechnicianCertification[]
  clients                Client[]
  sites                  Site[]
  siteContacts           SiteContact[]
  jobs                   Job[]
  jobAssignments         JobAssignment[]
  jobSafetyControls      JobSafetyControl[]
  jobWorkLogs            JobWorkLog[]
  jobMaterials           JobMaterial[]
  jobFiles               JobFile[]
  jobSignatures          JobSignature[]
  storageUploads         StorageUpload[]
  clockSessions          ClockSession[]
  timeEntries            TimeEntry[]
  overtimeAuthorizations OvertimeAuthorization[]
  approvals              Approval[]
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@index([status])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @db.Timestamptz
  createdAt      DateTime         @default(now()) @db.Timestamptz
  updatedAt      DateTime         @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

/// One PENDING invite per organization + email is enforced by a partial unique index in SQL:
/// OrganizationInvitation_one_pending_email_per_org_idx
model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  role           OrganizationRole
  teamId         String?          @db.Uuid
  tokenHash      String           @unique
  invitedById    String           @db.Uuid
  expiresAt      DateTime         @db.Timestamptz
  acceptedAt     DateTime?        @db.Timestamptz
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @db.Timestamptz
  updatedAt      DateTime         @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  team         Team?        @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([teamId])
}

model OrganizationSettings {
  organizationId          String   @id @db.Uuid
  jobNumberPrefix         String   @default("JOB-")
  timezone                String
  workingWeek             Json     @default("[\"MON\", \"TUE\", \"WED\", \"THU\", \"FRI\"]")
  requireClientSignature  Boolean  @default(true)
  requireGps              Boolean  @default(true)
  gpsReviewDistanceMeters Int      @default(250)
  allowManualTime         Boolean  @default(false)
  allowOvertimeRequests   Boolean  @default(true)
  requireRiskAssessment   Boolean  @default(false)
  defaultDailyHoursLimit  Decimal  @default(8) @db.Decimal(6, 2)
  defaultWeeklyHoursLimit Decimal  @default(40) @db.Decimal(6, 2)
  createdAt               DateTime @default(now()) @db.Timestamptz
  updatedAt               DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

/// Per-organization sequences. Increment jobNext inside a transaction.
model OrganizationCounter {
  organizationId String @id @db.Uuid
  jobNext        Int    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------
// SaaS plans (no payment provider integration)
// ---------------------------------------------------------------------------

model Plan {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique
  name              String
  status            PlanStatus      @default(ACTIVE)
  monthlyPriceCents Int?
  annualPriceCents  Int?
  displayPrice      String?
  currency          String          @default("USD")
  billingInterval   BillingInterval @default(ANNUAL)
  publiclyVisible   Boolean         @default(false)
  contactSales      Boolean         @default(false)
  sortOrder         Int             @default(100)
  maxUsers          Int
  maxStorageBytes   BigInt
  features          Json?
  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @updatedAt @db.Timestamptz

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([status, publiclyVisible, sortOrder])
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  trialStartedAt         DateTime?          @db.Timestamptz
  trialEndsAt            DateTime?          @db.Timestamptz
  graceEndsAt            DateTime?          @db.Timestamptz
  currentPeriodStart     DateTime?          @db.Timestamptz
  currentPeriodEnd       DateTime?          @db.Timestamptz
  activatedAt            DateTime?          @db.Timestamptz
  activatedByUserId      String?            @db.Uuid
  externalCustomerId     String?
  externalSubscriptionId String?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now()) @db.Timestamptz
  updatedAt              DateTime           @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  activatedBy  User?        @relation("SubscriptionActivator", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([planId])
  @@index([status])
  @@index([activatedByUserId])
}

/// Lightweight sales/support request. No payment provider.
model ActivationRequest {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  requestedByUserId String                  @db.Uuid
  requestType       CommercialRequestType   @default(ACTIVATION)
  message           String?
  status            ActivationRequestStatus @default(OPEN)
  createdAt         DateTime                @default(now()) @db.Timestamptz
  updatedAt         DateTime                @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy  User         @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, requestType, status, createdAt])
  @@index([requestedByUserId])
  @@index([status, createdAt])
}

/// Idempotent ledger for trial/renewal emails. One send per org + kind + period.
model SubscriptionNotification {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  kind           String
  periodKey      String
  sentAt         DateTime @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, kind, periodKey])
  @@index([organizationId, kind])
}

model PlatformCounter {
  id    String @id @default(uuid()) @db.Uuid
  key   String
  year  Int
  next  Int    @default(1)

  @@unique([key, year])
}

/// Singleton-style platform billing configuration. Payment destinations stay here, not in source.
model PlatformBillingSettings {
  id                           String   @id @default(uuid()) @db.Uuid
  key                          String   @unique @default("default")
  billingLegalName             String?
  billingAddress               String?
  billingEmail                 String?
  billingInstructions          String?
  paymentReferenceInstructions String?
  updatedByUserId              String?  @db.Uuid
  createdAt                    DateTime @default(now()) @db.Timestamptz
  updatedAt                    DateTime @updatedAt @db.Timestamptz
}

model Invoice {
  id                         String        @id @default(uuid()) @db.Uuid
  invoiceNumber              String        @unique
  organizationId             String        @db.Uuid
  subscriptionId             String?       @db.Uuid
  planId                     String        @db.Uuid
  type                       InvoiceType
  status                     InvoiceStatus @default(DRAFT)
  currency                   String        @default("USD")
  subtotalCents              Int
  totalCents                 Int
  billingPeriodStart         DateTime      @db.Timestamptz
  billingPeriodEnd           DateTime      @db.Timestamptz
  issuedAt                   DateTime?     @db.Timestamptz
  dueAt                      DateTime?     @db.Timestamptz
  paidAt                     DateTime?     @db.Timestamptz
  createdByPlatformUserId    String        @db.Uuid
  customerName               String
  customerBillingEmail       String
  paymentInstructionsSnapshot String?
  internalNotes              String?
  createdAt                  DateTime      @default(now()) @db.Timestamptz
  updatedAt                  DateTime      @updatedAt @db.Timestamptz

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription?          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy    User                   @relation("InvoiceCreator", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)
  paymentNotices InvoicePaymentNotice[]

  @@index([organizationId, status, createdAt])
  @@index([planId])
  @@index([subscriptionId])
  @@index([createdByPlatformUserId])
}

model InvoicePaymentNotice {
  id               String   @id @default(uuid()) @db.Uuid
  invoiceId        String   @db.Uuid
  organizationId   String   @db.Uuid
  submittedByUserId String  @db.Uuid
  reference        String?
  message          String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  submittedBy  User         @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Field operations — crew
// ---------------------------------------------------------------------------

model Team {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  name             String
  code             String?
  description      String?
  supervisorUserId String?      @db.Uuid
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supervisor   User?                     @relation("TeamSupervisor", fields: [supervisorUserId], references: [id], onDelete: Restrict)
  members      TeamMember[]
  jobs         Job[]
  invitations  OrganizationInvitation[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([supervisorUserId])
}

model TeamMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  teamId         String   @db.Uuid
  userId         String   @db.Uuid
  joinedAt       DateTime @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team         Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([organizationId, userId])
}

model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  TechnicianSkill[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model TechnicianSkill {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  skillId        String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill        Skill        @relation(fields: [skillId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([organizationId, userId])
}

model TechnicianCertification {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  userId            String    @db.Uuid
  name              String
  certificateNumber String?
  issuedAt          DateTime? @db.Timestamptz
  expiresAt         DateTime? @db.Timestamptz
  documentRef       String?
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId])
}

// ---------------------------------------------------------------------------
// Field operations — customers
// ---------------------------------------------------------------------------

model Client {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  name                String
  accountCode         String?
  email               String?
  phone               String?
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  billingEmail        String?
  website             String?
  notes               String?
  status              EntityStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sites        Site[]
  jobs         Job[]

  @@unique([id, organizationId])
  @@unique([organizationId, accountCode])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model Site {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  clientId         String       @db.Uuid
  name             String
  siteCode         String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  postalCode       String?
  country          String?
  latitude         Decimal?     @db.Decimal(10, 7)
  longitude        Decimal?     @db.Decimal(10, 7)
  timezone         String?
  siteContactName  String?
  siteContactEmail String?
  siteContactPhone String?
  notes            String?
  accessNotes      String?
  status           EntityStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client        @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contacts     SiteContact[]
  jobs         Job[]

  @@unique([id, organizationId])
  @@unique([organizationId, siteCode])
  @@index([organizationId, clientId])
  @@index([organizationId, status])
}

model SiteContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  siteId         String   @db.Uuid
  name           String
  title          String?
  phone          String?
  email          String?
  isPrimary      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, siteId])
  @@index([siteId, isPrimary])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model Job {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String      @db.Uuid
  jobNumber        String
  title            String
  clientId         String      @db.Uuid
  siteId           String      @db.Uuid
  jobType          String
  priority         JobPriority @default(NORMAL)
  teamId           String?     @db.Uuid
  supervisorUserId String?     @db.Uuid
  scheduledStart   DateTime?   @db.Timestamptz
  expectedFinish   DateTime?   @db.Timestamptz
  scope            String?
  internalNotes    String?
  workOrderNumber  String?
  status           JobStatus   @default(DRAFT)
  clientRepName    String?
  clientRepTitle   String?
  clientRepPhone   String?
  clientRepEmail   String?
  requireRiskAssessment Boolean @default(false)
  requirePermit         Boolean @default(false)
  requireLoto           Boolean @default(false)
  requireClientSignOff  Boolean @default(true)
  clientAccepted   Boolean     @default(false)
  clientComments   String?
  signedAt         DateTime?   @db.Timestamptz
  workPerformed    String?
  completionNotes  String?
  outcome          JobOutcome?
  outcomeReason    String?
  cancelReason     String?
  completedAt      DateTime?   @db.Timestamptz
  cancelledAt      DateTime?   @db.Timestamptz
  createdAt        DateTime    @default(now()) @db.Timestamptz
  updatedAt        DateTime    @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  site         Site         @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team         Team?        @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supervisor   User?        @relation("JobSupervisor", fields: [supervisorUserId], references: [id], onDelete: Restrict)

  assignments    JobAssignment[]
  safetyControls JobSafetyControl[]
  workLogs       JobWorkLog[]
  materials      JobMaterial[]
  files          JobFile[]
  signatures     JobSignature[]
  clockSessions  ClockSession[]
  timeEntries    TimeEntry[]
  overtimeAuthorizations OvertimeAuthorization[]

  @@unique([id, organizationId])
  @@unique([organizationId, jobNumber])
  @@index([organizationId, status, scheduledStart])
  @@index([organizationId, clientId])
  @@index([organizationId, siteId])
  @@index([organizationId, teamId])
  @@index([organizationId, supervisorUserId])
  @@index([organizationId, priority, status])
}

model JobAssignment {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  jobId          String            @db.Uuid
  userId         String            @db.Uuid
  role           JobAssignmentRole @default(TECHNICIAN)
  assignedAt     DateTime          @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([jobId, userId])
  @@index([organizationId, userId])
}

model JobSafetyControl {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  jobId             String    @db.Uuid
  code              String
  title             String
  description       String?
  isRequired        Boolean   @default(true)
  completedAt       DateTime? @db.Timestamptz
  completedByUserId String?   @db.Uuid
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  completedBy  User?        @relation(fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@unique([jobId, code])
  @@index([organizationId, jobId])
}

model JobWorkLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  jobId          String   @db.Uuid
  authorUserId   String   @db.Uuid
  body           String
  loggedAt       DateTime @default(now()) @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  author       User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, jobId, loggedAt])
}

model JobMaterial {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  jobId          String   @db.Uuid
  name           String
  sku            String?
  quantity       Decimal  @db.Decimal(12, 3)
  unit           String
  notes          String?
  addedByUserId  String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  addedBy      User         @relation(fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, jobId])
}

/// Object metadata only. Bytes live in S3-compatible storage.
/// Keys: organizations/{organizationId}/jobs/{jobId}/...
model JobFile {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  jobId          String      @db.Uuid
  objectKey      String      @unique
  originalName   String
  mimeType       String
  sizeBytes      BigInt
  type           JobFileType
  caption        String?
  capturedAt     DateTime?   @db.Timestamptz
  uploadedById   String      @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageUpload StorageUpload?

  @@unique([id, organizationId])
  @@index([organizationId, jobId, type])
  @@index([organizationId, createdAt])
}

/// Quota reservation for an in-flight upload. PENDING rows count against org storage until
/// COMPLETED, FAILED, CANCELLED, or expiresAt passes (treated as inactive without a worker).
model StorageUpload {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  userId         String               @db.Uuid
  objectKey      String               @unique
  originalName   String
  mimeType       String
  sizeBytes      BigInt
  status         StorageUploadStatus  @default(PENDING)
  purpose        StorageUploadPurpose
  jobId          String?              @db.Uuid
  jobFileId      String?              @db.Uuid
  expiresAt      DateTime             @db.Timestamptz
  createdAt      DateTime             @default(now()) @db.Timestamptz
  completedAt    DateTime?            @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobFile      JobFile?     @relation(fields: [jobFileId, organizationId], references: [id, organizationId], onDelete: SetNull)

  @@unique([jobFileId, organizationId])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, createdAt])
}

model JobSignature {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  jobId            String   @db.Uuid
  signerName       String
  signerTitle      String?
  signedAt         DateTime @db.Timestamptz
  objectKey        String   @unique
  mimeType         String
  capturedByUserId String   @db.Uuid
  ipAddress        String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  capturedBy   User         @relation(fields: [capturedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, jobId])
}

// ---------------------------------------------------------------------------
// Time
// ---------------------------------------------------------------------------

/// At most one OPEN session per technician is enforced by a partial unique index in SQL:
/// ClockSession_one_open_per_technician_idx
model ClockSession {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @db.Uuid
  technicianUserId       String             @db.Uuid
  jobId                  String?            @db.Uuid
  clockInAt              DateTime           @db.Timestamptz
  clockOutAt             DateTime?          @db.Timestamptz
  clockInLatitude        Decimal?           @db.Decimal(10, 7)
  clockInLongitude       Decimal?           @db.Decimal(10, 7)
  clockInAccuracyMeters  Decimal?           @db.Decimal(8, 2)
  clockOutLatitude       Decimal?           @db.Decimal(10, 7)
  clockOutLongitude      Decimal?           @db.Decimal(10, 7)
  clockOutAccuracyMeters Decimal?           @db.Decimal(8, 2)
  status                 ClockSessionStatus @default(OPEN)
  createdAt              DateTime           @default(now()) @db.Timestamptz
  updatedAt              DateTime           @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  technician   User         @relation(fields: [technicianUserId], references: [id], onDelete: Restrict)
  job          Job?         @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  timeEntries  TimeEntry[]

  @@unique([id, organizationId])
  @@index([organizationId, technicianUserId, status])
  @@index([organizationId, jobId])
}

model TimeEntry {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  userId          String          @db.Uuid
  jobId           String?         @db.Uuid
  clockSessionId  String?         @unique @db.Uuid
  workDate        DateTime        @db.Date
  startedAt       DateTime        @db.Timestamptz
  endedAt         DateTime?       @db.Timestamptz
  durationMinutes Int?
  type            TimeEntryType   @default(NORMAL)
  source          TimeEntrySource
  notes           String?
  status          TimeEntryStatus @default(DRAFT)
  validation      Json?
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  job                    Job?                    @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  clockSession             ClockSession?           @relation(fields: [clockSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  overtimeAuthorizationId  String?                 @db.Uuid
  overtimeAuthorization    OvertimeAuthorization?  @relation(fields: [overtimeAuthorizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, startedAt])
  @@index([overtimeAuthorizationId])
  @@index([organizationId, userId, workDate])
  @@index([organizationId, jobId])
  @@index([organizationId, status])
}

model OvertimeAuthorization {
  id                String                       @id @default(uuid()) @db.Uuid
  organizationId    String                       @db.Uuid
  userId            String                       @db.Uuid
  jobId             String                       @db.Uuid
  workDate          DateTime                     @db.Date
  authorizedStart   DateTime                     @db.Timestamptz
  authorizedEnd     DateTime                     @db.Timestamptz
  maxMinutes        Int
  reason            String
  status            OvertimeAuthorizationStatus  @default(PENDING)
  requestedByUserId String                       @db.Uuid
  requestedAt       DateTime                     @default(now()) @db.Timestamptz
  decidedByUserId   String?                      @db.Uuid
  decidedAt         DateTime?                    @db.Timestamptz
  decisionComment   String?
  createdAt         DateTime                     @default(now()) @db.Timestamptz
  updatedAt         DateTime                     @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  technician   User         @relation("OvertimeSubject", fields: [userId], references: [id], onDelete: Restrict)
  job          Job          @relation(fields: [jobId, organizationId], references: [id, organizationId], onDelete: Restrict)
  requestedBy  User         @relation("OvertimeRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("OvertimeDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  timeEntries  TimeEntry[]

  @@index([organizationId, status])
  @@index([organizationId, userId, workDate])
  @@index([organizationId, jobId])
}

// ---------------------------------------------------------------------------
// Approvals, notifications, audit
// ---------------------------------------------------------------------------

model Approval {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @db.Uuid
  type                   ApprovalType
  status                 ApprovalStatus     @default(PENDING)
  subjectType            String
  subjectId              String             @db.Uuid
  requestedByUserId      String             @db.Uuid
  requestedAt            DateTime           @default(now()) @db.Timestamptz
  assignedApproverUserId String?            @db.Uuid
  assignedRole           OrganizationRole?
  decidedByUserId        String?            @db.Uuid
  decidedAt              DateTime?          @db.Timestamptz
  decision               String?
  comment                String?
  createdAt              DateTime           @default(now()) @db.Timestamptz
  updatedAt              DateTime           @updatedAt @db.Timestamptz

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy      User         @relation("ApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  assignedApprover User?        @relation("ApprovalAssignee", fields: [assignedApproverUserId], references: [id], onDelete: Restrict)
  decidedBy        User?        @relation("ApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, type, subjectId])
  @@index([organizationId, status, type])
  @@index([organizationId, subjectType, subjectId])
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String?            @db.Uuid
  userId            String             @db.Uuid
  type              String
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?            @db.Uuid
  payload           Json?
  status            NotificationStatus @default(UNREAD)
  readAt            DateTime?          @db.Timestamptz
  createdAt         DateTime           @default(now()) @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, type, relatedEntityId])
}

/// Append-only. organizationId is null for platform actions. actorUserId is null for system events.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  entityType     String
  entityId       String
  oldValues      Json?
  newValues      Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now()) @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
