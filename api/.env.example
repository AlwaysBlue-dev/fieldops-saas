NODE_ENV=
PORT=

DATABASE_URL=

WEB_URL=
APP_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

COOKIE_SECURE=
COOKIE_SAME_SITE=

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=
S3_PRESIGNED_GET_EXPIRY_SECONDS=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# smtp (default / Mailpit) | resend | none
EMAIL_PROVIDER=
# Staging/production (Resend): FieldKeel <support@fieldkeel.com>
# Local Mailpit can use the same address; delivery still goes to Mailpit.
EMAIL_FROM=FieldKeel <support@fieldkeel.com>
EMAIL_REPLY_TO=support@fieldkeel.com
RESEND_API_KEY=

MAX_UPLOAD_SIZE_MB=
SEED_PASSWORD=
DEFAULT_PLAN_CODE=
PLATFORM_SALES_EMAIL=support@fieldkeel.com
PLATFORM_SUPPORT_EMAIL=support@fieldkeel.com
SECURITY_CONTACT_EMAIL=support@fieldkeel.com
LEGAL_ENTITY_NAME=
LEGAL_GOVERNING_LAW=
TERMS_VERSION=
PRIVACY_VERSION=
BILLING_POLICY_VERSION=
LEGAL_EFFECTIVE_DATE=
# Select the Paddle account for this deployment. Keep staging on sandbox; use production only on the production API.
PADDLE_ENVIRONMENT=sandbox
# Paddle Sandbox credentials (staging/local testing only)
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_SANDBOX_STARTER_PRICE_ID=
PADDLE_SANDBOX_PROFESSIONAL_PRICE_ID=
# Paddle live credentials (production only; use IDs and secrets from Paddle's live account)
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_LIVE_STARTER_PRICE_ID=
PADDLE_LIVE_PROFESSIONAL_PRICE_ID=

# AI Workforce (backend-only). Never expose keys to the web client.
# Router order: Groq → Gemini → OpenRouter. Missing keys skip that provider (not a crash).
# Development stub: AI_PROVIDER=stub (never a production substitute)
AI_PROVIDER=groq
GROQ_API_KEY=
# Example: qwen/qwen3.8-27b — set explicitly for your Groq account
GROQ_MODEL=
# Request timeout ms (default 120000). Abort does not prove the provider ran the request.
GROQ_TIMEOUT_MS=120000
GEMINI_API_KEY=
# Example: gemini-2.5-flash — set explicitly for your Google AI account
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=120000
OPENROUTER_API_KEY=
# Example: qwen/qwen3-32b — set explicitly for your OpenRouter account
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=120000
# Optional OpenRouter attribution headers (only sent when set)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# Optional PENDING lease TTL seconds (default 300). Heartbeat ~60s while calls run.
AI_TASK_RESERVATION_TTL_SECONDS=300
